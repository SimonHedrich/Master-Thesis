@article{hedrichGeneratingSyntheticDatasets2026,
	title = {Generating synthetic datasets using inpainting for the optimization of object detectors},
	url = {https://zenodo.org/records/22882790},
	doi = {10.5281/zenodo.22882790},
	abstract = {In object recognition, accurately detecting small objects within large images poses a signifi-

cant challenge, particularly in real-world applications such as traffic monitoring, autonomous

driving, and security surveillance. These applications often require the detection of cars that

may appear as small objects within a broader scene due to distance, perspective, or resolution

constraints. Despite advances in object recognition models, many existing training datasets

predominantly contain images in which objects of interest, such as cars, are relatively large and

well defined. Consequently, models trained on such datasets often demonstrate sub-optimal

performance when tasked with recognizing smaller instances of these objects. This thesis

addresses the critical problem of improving the detection of small cars in large images by

exploring new approaches to dataset generation and model training.

The research begins with a comprehensive review of existing object recognition techniques and

generative models, with a focus on their current limitations in detecting small objects. An

initial evaluation identifies the gaps in widely used datasets that lack sufficient representation

of small objects, particularly cars. To tackle this problem, the thesis proposes the generation

of synthetic datasets using generative models to augment existing data with a diverse range

of car images, specifically focusing on smaller object sizes. This is achieved by employing

diffusion models to create synthetic images that contain cars in various scales, positions, and

contexts. These synthetic datasets are then used to train object detection models, with a

particular emphasis on their ability to recognize small car instances effectively.

The models are evaluated using a carefully selected set of metrics to assess their performance

on small object recognition. A proof of concept is conducted to compare the performance of

models trained on traditional datasets with those trained on the newly generated datasets.

The results demonstrate that the models trained with the synthetic data exhibit improved ca-

pabilities in detecting small cars in a variety of scenarios. This work provides a novel approach

to improving object recognition performance for small objects, highlighting the importance of

tailor-made dataset generation to address specific challenges within the field. The findings of

this thesis offer valuable insight for further research and practical applications in areas where

accurate detection of small objects is crucial.},
	language = {eng},
	urldate = {2026-09-21},
	publisher = {Zenodo},
	author = {Hedrich, Simon},
	month = jan,
	year = {2025},
	keywords = {Computer vision, Generative artificial intelligence, Object detection},
}

@misc{beeryEfficientPipelineCamera2019,
	title = {Efficient {Pipeline} for {Camera} {Trap} {Image} {Review}},
	url = {http://arxiv.org/abs/1907.06772},
	doi = {10.48550/arXiv.1907.06772},
	abstract = {Biologists all over the world use camera traps to monitor biodiversity and wildlife population density. The computer vision community has been making strides towards automating the species classification challenge in camera traps, but it has proven difficult to to apply models trained in one region to images collected in different geographic areas. In some cases, accuracy falls off catastrophically in new region, due to both changes in background and the presence of previously-unseen species. We propose a pipeline that takes advantage of a pre-trained general animal detector and a smaller set of labeled images to train a classification model that can efficiently achieve accurate results in a new region.},
	urldate = {2026-09-19},
	publisher = {arXiv},
	author = {Beery, Sara and Morris, Dan and Yang, Siyu},
	month = jul,
	year = {2019},
	note = {arXiv:1907.06772 [cs.CV]},
	keywords = {Computer Science - Computer Vision and Pattern Recognition},
}

@misc{bochkovskiyYOLOv4OptimalSpeed2020,
	title = {{YOLOv4}: {Optimal} {Speed} and {Accuracy} of {Object} {Detection}},
	shorttitle = {{YOLOv4}},
	url = {http://arxiv.org/abs/2004.10934},
	doi = {10.48550/arXiv.2004.10934},
	abstract = {There are a huge number of features which are said to improve Convolutional Neural Network (CNN) accuracy. Practical testing of combinations of such features on large datasets, and theoretical justification of the result, is required. Some features operate on certain models exclusively and for certain problems exclusively, or only for small-scale datasets; while some features, such as batch-normalization and residual-connections, are applicable to the majority of models, tasks, and datasets. We assume that such universal features include Weighted-Residual-Connections (WRC), Cross-Stage-Partial-connections (CSP), Cross mini-Batch Normalization (CmBN), Self-adversarial-training (SAT) and Mish-activation. We use new features: WRC, CSP, CmBN, SAT, Mish activation, Mosaic data augmentation, CmBN, DropBlock regularization, and CIoU loss, and combine some of them to achieve state-of-the-art results: 43.5\% AP (65.7\% AP50) for the MS COCO dataset at a realtime speed of {\textasciitilde}65 FPS on Tesla V100. Source code is at https://github.com/AlexeyAB/darknet},
	urldate = {2026-09-19},
	publisher = {arXiv},
	author = {Bochkovskiy, Alexey and Wang, Chien-Yao and Liao, Hong-Yuan Mark},
	month = apr,
	year = {2020},
	note = {arXiv:2004.10934 [cs.CV]},
	keywords = {Computer Science - Computer Vision and Pattern Recognition, Electrical Engineering and Systems Science - Image and Video Processing},
}

